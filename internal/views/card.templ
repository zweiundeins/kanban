package views

import (
	"kanban/internal/app"
	"time"
)

// DetailClosed is the dialog when no card is open in the tab.
templ DetailClosed(board int64) {
	<sb-modal id="detail" class="detail" heading="Card" open="false" data-on:sb-close={ openExpr(board, 0) }></sb-modal>
}

// DetailGone is the dialog for a card that no longer exists.
templ DetailGone(board int64) {
	<sb-modal id="detail" class="detail" heading="Card not found" open data-on:sb-close={ openExpr(board, 0) }>
		<p>This card was archived or deleted.</p>
		<sb-button slot="footer" data-sb-close="close">Close</sb-button>
	</sb-modal>
}

func labelOn(c *app.CardDetail, l app.Label) bool {
	for _, x := range c.Labels {
		if x.ID == l.ID {
			return true
		}
	}
	return false
}

func cardURL(c *app.CardDetail, rest string) string {
	return boardURL(c.BoardID, "/cards/"+id(c.ID)+rest)
}

// Detail is an open card. Like the board, it is the same for everyone on
// the board: a viewer's own comments get their delete button from CSS.
templ Detail(c *app.CardDetail, descHTML string, viewers []app.User, now time.Time) {
	<sb-modal id="detail" class="detail" heading={ c.Title } open data-on:sb-close={ openExpr(c.BoardID, 0) }>
		<div class="detail-grid">
			<div class="detail-main">
				<section class="detail-title">
					@inlineTitle("t"+id(c.ID), "detail-title", "title-text", c.Title, c.Title+", card title: press Enter to rename", "Card title", cardURL(c, "/rename"), "title", 200)
					<p class="muted">
						in <strong>{ c.ListName }</strong>, added by { c.CreatedBy.Name } { ago(c.CreatedAt, now) }
					</p>
					if len(viewers) > 1 {
						<p class="viewers">
							<span class="avatars">
								for _, v := range viewers {
									@Avatar(v, "xs")
								}
							</span>
							<span class="muted small">{ viewing(viewers) }</span>
						</p>
					}
				</section>
				<section class="detail-section" aria-labelledby="desc-h">
					<div class="section-head">
						<h3 id="desc-h">Description</h3>
						<button type="button" class="btn ghost sm" data-show={ "$_edit !== 'd" + id(c.ID) + "'" } data-on:click={ "$_pend.d" + id(c.ID) + " = ''; $_in.d" + id(c.ID) + " = el.dataset.desc; $_edit = 'd" + id(c.ID) + "'" } data-desc={ c.Description }>Edit</button>
					</div>
					<div data-show={ "$_edit !== 'd" + id(c.ID) + "'" }>
						if descHTML != "" {
							<div class="markdown">
								@templ.Raw(descHTML)
							</div>
						} else {
							<p class="muted">No description yet.</p>
						}
					</div>
					<form
						class="desc-edit"
						style="display: none"
						data-show={ "$_edit === 'd" + id(c.ID) + "'" }
						data-on:submit__prevent={ ActKey(cardURL(c, "/description"), "d"+id(c.ID), "text: $_in.d"+id(c.ID)) }
						data-effect={ Done("d"+id(c.ID)) + " && $_edit === 'd" + id(c.ID) + "' && ($_edit = '')" }
					>
						<textarea data-bind={ "_in.d" + id(c.ID) } data-ignore-morph rows="8" aria-label="Description (Markdown)" data-attr:readonly={ Pending("d" + id(c.ID)) }></textarea>
						<div class="row">
							<button type="submit" class="btn primary sm" data-attr:aria-busy={ Pending("d" + id(c.ID)) }>Save</button>
							<button type="button" class="btn ghost sm" data-on:click="$_edit = ''">Cancel</button>
							<span class="muted small">Markdown works: **bold**, lists, links.</span>
						</div>
					</form>
				</section>
				<section class="detail-section" aria-labelledby="comments-h">
					<h3 id="comments-h">Comments</h3>
					<form class="comment-new" data-on:submit__prevent={ "$_in.c" + id(c.ID) + "?.trim() && (" + ActKey(cardURL(c, "/comments"), "k"+id(c.ID), "body: $_in.c"+id(c.ID)) + ")" }>
						<textarea data-bind={ "_in.c" + id(c.ID) } data-ignore-morph rows="2" placeholder="Write a comment…" aria-label="New comment" data-attr:readonly={ Pending("k" + id(c.ID)) } data-on:keydown="evt.key === 'Enter' && (evt.metaKey || evt.ctrlKey) && el.form.requestSubmit()"></textarea>
						<button type="submit" class="btn sm" data-attr:aria-busy={ Pending("k" + id(c.ID)) }>Comment</button>
					</form>
					<ol class="comments">
						for i := len(c.CommentList) - 1; i >= 0; i-- {
							{{ cm := c.CommentList[i] }}
							<li class="comment" id={ "comment-" + id(cm.ID) } data-author={ id(cm.Author.ID) } data-class:pending={ Pending("x" + id(cm.ID)) }>
								@Avatar(cm.Author, "sm")
								<div class="comment-body">
									<p class="comment-head"><strong>{ cm.Author.Name }</strong> <span class="muted small">{ ago(cm.CreatedAt, now) }</span></p>
									<p class="comment-text">{ cm.Body }</p>
								</div>
								<button type="button" class="icon-btn own-only" aria-label="Delete your comment" data-on:click={ "confirm('Delete your comment?') && (" + ActKey(boardURL(c.BoardID, "/comments/"+id(cm.ID)+"/delete"), "x"+id(cm.ID), "") + ")" }>
									<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3 4.5h10M6.5 4.5V3h3v1.5M5 4.5l.6 8.5h4.8l.6-8.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path></svg>
								</button>
							</li>
						}
					</ol>
				</section>
			</div>
			<aside class="detail-side">
				<section class="detail-section" aria-labelledby="labels-h">
					<h3 id="labels-h">Labels</h3>
					<ul class="label-picker">
						for _, l := range c.BoardLabels {
							{{ on := labelOn(c, l) }}
							<li>
								<button
									type="button"
									class={ "label", "l-" + l.Color, templ.KV("off", !on) }
									aria-pressed={ boolStr(on) }
									data-class:pending={ Pending("lb" + id(l.ID)) }
									data-on:click={ ActKey(cardURL(c, "/labels/"+id(l.ID)), "lb"+id(l.ID), "on: "+boolStr(!on)) }
								>{ l.Name }</button>
							</li>
						}
					</ul>
					<details class="new-label">
						<summary>New label</summary>
						<form data-on:submit__prevent={ "$_in.ln?.trim() && (" + ActKey(cardURL(c, "/labels/new"), "ln", "name: $_in.ln, color: $_in.lc || 'green'") + ")" }>
							<input data-bind="_in.ln" data-ignore-morph maxlength="40" placeholder="Name" aria-label="Name of the new label"/>
							<select data-bind="_in.lc" data-ignore-morph aria-label="Colour">
								for _, col := range app.LabelColors {
									<option value={ col }>{ col }</option>
								}
							</select>
							<button type="submit" class="btn sm" data-attr:aria-busy={ Pending("ln") }>Add</button>
						</form>
					</details>
				</section>
				<section class="detail-section" aria-labelledby="due-h">
					<h3 id="due-h">Due date</h3>
					<div class="due-row">
						<input
							type="date"
							value={ c.DueOn }
							aria-label="Due date"
							data-class:pending={ Pending("du" + id(c.ID)) }
							data-on:change={ ActKey(cardURL(c, "/due"), "du"+id(c.ID), "day: el.value") }
						/>
						if c.DueOn != "" {
							<label class="check">
								<input
									type="checkbox"
									checked?={ c.DueDone }
									data-class:pending={ Pending("dd" + id(c.ID)) }
									data-on:change={ ActKey(cardURL(c, "/due-done"), "dd"+id(c.ID), "done: el.checked") }
								/>
								Done
							</label>
							<button type="button" class="btn ghost sm" data-on:click={ ActKey(cardURL(c, "/due"), "du"+id(c.ID), "day: ''") }>Remove</button>
						}
					</div>
					if c.DueOn != "" {
						{{ d := DueOf(c.DueOn, c.DueDone, now) }}
						<p class={ "badge", "due", d.Class }>{ d.Full }</p>
					}
				</section>
				<section class="detail-section">
					<h3>Actions</h3>
					<button
						type="button"
						class="btn danger sm"
						data-attr:aria-busy={ Pending("ar" + id(c.ID)) }
						data-on:click={ "confirm('Archive this card?') && (" + ActKey(cardURL(c, "/archive"), "ar"+id(c.ID), "") + ")" }
					>Archive card</button>
				</section>
			</aside>
		</div>
	</sb-modal>
}

func boolStr(b bool) string {
	if b {
		return "true"
	}
	return "false"
}
