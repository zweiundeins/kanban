# /etc/systemd/system/kanban.service
[Unit]
Description=Kanban (Go, Datastar, SQLite)
After=network-online.target
Wants=network-online.target

[Service]
User=kanban
Group=kanban
StateDirectory=kanban
WorkingDirectory=/var/lib/kanban
# Kanban on 127.0.0.1:8095 for Caddy, its metrics on 127.0.0.1:8195 for
# Prometheus only (observability/kanban.metrics.yml). Change a port here, in
# SocketBindAllow and in kanban.caddy or kanban.metrics.yml together.
ExecStart=/opt/kanban/kanban serve \
	-addr 127.0.0.1:8095 \
	-metrics 127.0.0.1:8195 \
	-db /var/lib/kanban/kanban.db \
	-secure \
	-origins https://kanban.zweiundeins.gmbh \
	-reset-at 03:00
# Each busy live stream keeps about 1.6 MB of zstd state (2.1 MB of
# brotli): the limit makes the garbage collector work harder before memory
# grows past it.
Environment=GOMEMLIMIT=600MiB
Restart=always
RestartSec=1
# SIGTERM: stop accepting, end the streams (pages reconnect), commit what is queued.
KillSignal=SIGTERM
TimeoutStopSec=20
LimitNOFILE=65536

# Network: loopback only, both ways. Caddy and Prometheus connect from
# 127.0.0.1; kanban itself connects nowhere, not even to DNS. It may bind
# its two ports and no other.
IPAddressDeny=any
IPAddressAllow=localhost
SocketBindAllow=tcp:8095
SocketBindAllow=tcp:8195
SocketBindDeny=any

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
